// Cloudflare: de site is statisch, met één stukje code voor het
// contactformulier. Cloudflare draait bij elke push naar main eerst
// tools/bouw-site.py en publiceert daarna de map dist/.
{
  "name": "polares",
  "compatibility_date": "2026-09-24",
  // Alleen het contactformulier: POST /api/contact (zie worker/index.js).
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Geen automatische adressen zonder .html: de canonieke adressen, de
    // sitemap en alle interne links gebruiken .html. Met de standaard zou
    // Cloudflare elk van die adressen omleiden naar een versie zonder .html.
    "html_handling": "none",
    "not_found_handling": "404-page",
    // De code draait alleen voor het formulier. Al de rest komt rechtstreeks
    // uit dist/ en kost dus ook geen aanroep van de Worker.
    "run_worker_first": ["/api/*"]
  },
  // De adressen van de site. Cloudflare koppelt ze bij elke deploy en maakt
  // zelf het certificaat; er mag voor die namen geen A-, AAAA- of CNAME-record
  // in de DNS staan. www gaat met de Redirect Rule "WWW to root" naar
  // polares.be. Een adres dat hier ontbreekt, kan bij een deploy loskomen:
  // voeg ze dus hier toe en niet in het dashboard.
  "routes": [
    { "pattern": "polares.be", "custom_domain": true },
    { "pattern": "www.polares.be", "custom_domain": true },
    { "pattern": "polares.meyten.com", "custom_domain": true }
  ],
  // Het formulier verstuurt via Resend. AFZENDER moet op een domein staan dat
  // bij Resend geverifieerd is (polares.be, sinds 9 oktober 2026). Het adres
  // hoeft geen mailbox te zijn: antwoorden gaan naar de bezoeker (Reply-To).
  // De sleutel staat niet hier maar als geheim in Cloudflare: RESEND_API_KEY.
  "vars": {
    "AFZENDER": "website@polares.be",
    "ONTVANGER": "info@polares.be"
  },
  "observability": { "enabled": true }
}
